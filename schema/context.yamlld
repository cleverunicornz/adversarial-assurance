  artifact_sha256:
    "@id": "urn:assurance:artifact-sha256"
  content_digest:
    "@id": "urn:assurance:content-digest"
  producer:
    "@id": "urn:assurance:producer"
  ci_run:
    "@id": "urn:assurance:ci-run"
    "@type": "@id"
  actor:
    "@id": "urn:assurance:actor"
  disposition:
    "@id": "urn:assurance:disposition"
  lane:
    "@id": "urn:assurance:lane"
  state:
    "@id": "urn:assurance:state"
  human_invoked:
    "@id": "urn:assurance:human-invoked"
