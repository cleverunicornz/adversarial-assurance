"@context": "urn:assurance:context/v1"
"@id": "urn:assurance:record/demo/promise/behavior"
"@type": "urn:assurance:ontology/Promise"
schema_version: 1
sequence: 1
label: "Observable behavior"
body: >
  The fixture behavior is retained at the promised boundary and can be judged
  from its exact artifact.
polarity: ELICIT
envelope: "The fixture file is the complete bounded surface."
witnessed_by:
  - "urn:assurance:record/demo/witness/observation"
judged_by:
  - "urn:assurance:record/demo/oracle/verdict"
resolves_to: "urn:assurance:path/situation/assurance/runs/demo/evidence/observed.txt"
part_of: "urn:assurance:record/demo/run"
